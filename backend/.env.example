# Local demo configuration. Copy to .env and load with uvicorn --env-file .env.
DATABASE_PATH=data/app.db
DEMO_MODE=true
CAMERA_DEVICE=0
CONFIDENCE_THRESHOLD=0.75
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
# For a physical camera and real inference, set DEMO_MODE=false.
ROBOFLOW_MODEL_ID=
ROBOFLOW_API_KEY=
# Exact model labels mapped to catalog product IDs. Example: {"egg-carton":1}
ROBOFLOW_LABEL_MAP={}
