# Local demo configuration. Copy to .env and load with uvicorn --env-file .env.
DATABASE_PATH=data/app.db
DEMO_MODE=true
# Lower (even to 0) to see every mapped detection as a candidate, ranked by confidence.
CONFIDENCE_THRESHOLD=0.75
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
# For the browser's camera and real inference, set DEMO_MODE=false.
# Example: sang-rqj4u/ozm-4-yolov8n-t1
ROBOFLOW_MODEL_ID=
ROBOFLOW_API_KEY=
# Exact model labels mapped to catalog product IDs. Example: {"egg-carton":1}
ROBOFLOW_LABEL_MAP={}
